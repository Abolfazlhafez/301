# این تنظیم برای رفع خطای ERESOLVE در نصب npm است:
# react-i18next هنوز رنج peerDependency تایپ‌اسکریپتش را برای نسخه‌ی ۶
# به‌روزرسانی نکرده (فقط ^5 نوشته)، در حالی که این پیج به‌صورت اختیاری
# (peerOptional) است و مشکل واقعی در کد ایجاد نمی‌کند. این خط به npm
# می‌گوید مثل قبل از npm 7 رفتار کند و روی این‌جور ناسازگاری‌های
# peer اختیاری، نصب را متوقف نکند.
legacy-peer-deps=true
